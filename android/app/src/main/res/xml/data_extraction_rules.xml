<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup or device-transfer of task data: everything stays local. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
</data-extraction-rules>
