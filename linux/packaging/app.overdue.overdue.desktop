[Desktop Entry]
Type=Application
Name=Overdue
GenericName=Task manager
Comment=Offline task manager and agenda
Exec=overdue %U
Icon=app.overdue.overdue
Terminal=false
Categories=Office;ProjectManagement;Utility;
StartupWMClass=app.overdue.overdue
Actions=new-task;overlay;

[Desktop Action new-task]
Name=New task
Exec=overdue --new-task

[Desktop Action overlay]
Name=Show overlay
Exec=overdue --overlay
